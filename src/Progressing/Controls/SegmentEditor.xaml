<UserControl x:Class="Progressing.Controls.SegmentEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Progressing.Controls">
    <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <local:TimeTextBox x:Name="StartBox" Grid.Column="0" TimeChanged="StartBox_TimeChanged" />
        <TextBlock Grid.Column="1" Text=" 到 " VerticalAlignment="Center" Foreground="#888" />
        <local:TimeTextBox x:Name="EndBox" Grid.Column="2" TimeChanged="EndBox_TimeChanged" />

        <TextBox x:Name="TextInputBox" Grid.Column="3" Margin="8,0"
                 VerticalContentAlignment="Center" TextChanged="TextInputBox_TextChanged" />

        <Button x:Name="ColorButton" Grid.Column="4" Width="30" Height="26"
                ToolTip="选择颜色" Click="ColorButton_Click"
                BorderBrush="#40000000" BorderThickness="1" />

        <Button Grid.Column="5" Content="↑" Width="26" Height="26" Margin="4,0,0,0"
                ToolTip="上移" Click="MoveUp_Click" />
        <Button Grid.Column="6" Content="↓" Width="26" Height="26" Margin="2,0,0,0"
                ToolTip="下移" Click="MoveDown_Click" />
        <Button Grid.Column="7" Content="✕" Width="26" Height="26" Margin="6,0,0,0"
                ToolTip="删除备注" Click="Delete_Click" />
    </Grid>
</UserControl>
