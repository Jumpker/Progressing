<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Tray\Progressing.ico</ApplicationIcon>
    <!-- 发布版本号：设置窗口"版本"与 exe 文件属性（右键 → 属性 → 详细信息）保持一致 -->
    <Version>1.0.1</Version>
    <!-- 只保留中文 + 英文系统资源包，去掉其余 12 种语言（约 -15MB） -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <!-- 发布时把卸载程序（自包含单文件 uninstall.exe）一并输出到 publish 目录 -->
  <Target Name="PublishUninstaller" AfterTargets="Publish">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Uninstaller\Uninstaller.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishTrimmed=true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Uninstaller\bin\$(Configuration)\net10.0-windows\win-x64\publish\uninstall.exe"
          DestinationFolder="$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0-windows\win-x64\publish\"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Uninstaller\bin\$(Configuration)\net10.0-windows\win-x64\publish\uninstall.exe')" />
  </Target>

  <!-- 发布后清理调试符号文件（*.pdb，含两个 ~100MB 的原生 PDB） -->
  <Target Name="TrimPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <PublishTrash Include="$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0-windows\win-x64\publish\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishTrash)" />
  </Target>

</Project>
