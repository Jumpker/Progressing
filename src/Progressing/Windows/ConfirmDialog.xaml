<Window x:Class="Progressing.Windows.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="380" Height="210"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Border x:Name="RootBorder" Margin="12"
            Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（拖拽区） -->
            <Grid x:Name="DragStrip" Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="DragStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Padding="0,0"
                        Margin="0,0,10,0" VerticalAlignment="Center" Click="Cancel_Click" ToolTip="取消" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap"
                       Margin="16,2,16,12" VerticalAlignment="Center" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,14">
                <Button Content="取消" Width="80" Height="28" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="删除" Width="80" Height="28" IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
