<Window x:Class="Progressing.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Progressing.ViewModels"
        xmlns:controls="clr-namespace:Progressing.Controls"
        Title="Progressing 设置" Width="960" Height="640" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F7F6F3">
    <Window.Resources>
        <!-- 隐藏转换 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBoolConverter x:Key="InvBool" />
        <vm:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 标签栏 ===================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8D5CC" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋" Width="30" Height="26" Margin="6,0,0,0"
                        ToolTip="新建进度条" Click="AddInstance_Click" />
                <ListBox x:Name="TabsHost" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="#5A5A5A" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="重命名"
                                                  Command="{Binding PlacementTarget.DataContext.RenameInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="复制"
                                                  Command="{Binding PlacementTarget.DataContext.CloneInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="删除"
                                                  Command="{Binding PlacementTarget.DataContext.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="#4A90D9" />
                                    <Setter Property="Foreground" Value="#1F4E79" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1EFEA" />
                                </Trigger>
                                <!-- 全局标签页无右键菜单 -->
                                <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                                    <Setter Property="ContextMenu" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center"
                                           Visibility="{Binding IsRenaming, Converter={StaticResource InvBool}}" />
                                <TextBox x:Name="RenameBox" Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                         KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== 内容区 ===================== -->
        <ContentControl Grid.Row="1" Content="{Binding SelectedTab}" Focusable="False">
            <ContentControl.Resources>
                <!-- 全局页 -->
                <DataTemplate DataType="{x:Type vm:GlobalViewModel}">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="全局设置" FontSize="18" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,18" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="开机自启" Width="120" VerticalAlignment="Center" Foreground="#333" />
                            <CheckBox IsChecked="{Binding AutoStart}" VerticalAlignment="Center" ToolTip="登录 Windows 后自动启动 Progressing" />
                            <TextBlock Text="（写入注册表 HKCU Run）" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#8A8A8A" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="版本" Width="120" VerticalAlignment="Center" Foreground="#333" />
                            <TextBlock Text="{Binding Version}" VerticalAlignment="Center" Foreground="#5A5A5A" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!-- 实例页 -->
                <DataTemplate DataType="{x:Type vm:InstanceViewModel}">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧分区导航 -->
                        <ListBox Grid.Column="0" x:Name="SectionNav" SelectedIndex="{Binding SectionIndex}"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                            <ListBoxItem Content="外观" />
                            <ListBoxItem Content="位置" />
                            <ListBoxItem Content="指针" />
                            <ListBoxItem Content="时间段" />
                            <ListBoxItem Content="文字样式" />
                            <ListBoxItem Content="其它" />
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="Foreground" Value="#333" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#4A90D9" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 分区内容 -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="4,0,8,16">
                                <!-- 分区内容：按 SectionIndex 切换可见性 -->
                                <!-- ===== 外观 ===== -->
                                <StackPanel x:Name="SecAppearance">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SectionIndex}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="显示进度条" Width="120" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="置顶显示" Width="120" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding Topmost}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="不透明度" Width="120" VerticalAlignment="Center" />
                                        <Slider Minimum="0" Maximum="100" Width="200" Value="{Binding Opacity}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Opacity}" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="边框" Width="120" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding BorderEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Width="28" Height="20" Click="BorderColor_Click"
                                                Background="{Binding BorderColor, Converter={StaticResource HexToBrush}}"
                                                ToolTip="边框颜色" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== 位置 ===== -->
                                <StackPanel x:Name="SecPosition">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SectionIndex}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="位置" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="方向" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="120" ItemsSource="{Binding OrientationOptions}"
                                                  SelectedValue="{Binding Orientation}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="镜像时间轴" Width="120" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding Mirrored}" VerticalAlignment="Center" ToolTip="以进度条中心为对称轴翻转时间映射" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="长度" Width="120" VerticalAlignment="Center" />
                                        <Slider Minimum="200" Maximum="2000" Width="200" Value="{Binding Length}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Length, StringFormat={}{0:0}}" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="宽度" Width="120" VerticalAlignment="Center" />
                                        <Slider Minimum="2" Maximum="10" Width="200" Value="{Binding Width}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Width, StringFormat={}{0:0}}" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A" />
                                    </StackPanel>
                                    <Separator Margin="0,6,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="快速定位" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="140" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" ToolTip="选择后立即定位并复位（一次性）" />
                                        <TextBlock Text="显示器" Width="60" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <ComboBox Width="160" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="拖动更改位置" Width="120" VerticalAlignment="Center" />
                                        <Button MinWidth="160" Padding="12,6" Click="EditMode_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="进入位置编辑模式" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                            <Setter Property="Content" Value="完成" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== 指针 ===== -->
                                <StackPanel x:Name="SecPointer">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SectionIndex}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="指针" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="图标来源" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="120" ItemsSource="{Binding PointerSourceOptions}"
                                                  SelectedValue="{Binding PointerSource}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="文件" Width="120" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding PointerFilePath}" Width="260" VerticalAlignment="Center" ToolTip="支持 .png / .svg" />
                                        <Button Content="浏览…" Margin="6,0,0,0" Padding="10,4" Click="PointerBrowse_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="大小" Width="120" VerticalAlignment="Center" />
                                        <Slider Minimum="8" Maximum="64" Width="200" Value="{Binding PointerSize}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PointerSize, StringFormat={}{0:0}px}" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="横放指向" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="120" ItemsSource="{Binding HorizontalDirectionOptions}"
                                                  SelectedValue="{Binding HorizontalDirection}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="竖放指向" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="120" ItemsSource="{Binding VerticalDirectionOptions}"
                                                  SelectedValue="{Binding VerticalDirection}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== 时间段 ===== -->
                                <StackPanel x:Name="SecNotes">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SectionIndex}" Value="3">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="时间段备注" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" />
                                    <TextBlock Text="同一条进度条内时间段不允许重叠（首尾相接允许）。删除备注后其随机颜色回归未使用池。" 
                                               Foreground="#8A8A8A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <ItemsControl x:Name="NotesList" ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:SegmentEditor Loaded="NoteEditor_Loaded" Unloaded="NoteEditor_Unloaded" Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋ 添加时间段" Width="140" Height="30" Margin="0,10,0,0" Click="AddNote_Click" />
                                </StackPanel>

                                <!-- ===== 文字样式 ===== -->
                                <StackPanel x:Name="SecTextStyle">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SectionIndex}" Value="4">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="备注文字样式" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="基准方向" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="120" ItemsSource="{Binding TextAnchorOptions}"
                                                  SelectedValue="{Binding TextAnchor}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="排列方向" Width="120" VerticalAlignment="Center" />
                                        <ComboBox Width="120" ItemsSource="{Binding TextArrangementOptions}"
                                                  SelectedValue="{Binding TextArrangement}" SelectedValuePath="Value"
                                                  DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="文字大小" Width="120" VerticalAlignment="Center" />
                                        <Slider Minimum="8" Maximum="72" Width="200" Value="{Binding TextFontSize}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TextFontSize, StringFormat={}{0:0}}" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5A5A5A" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="文字颜色" Width="120" VerticalAlignment="Center" />
                                        <Button Width="28" Height="20" Click="TextColor_Click"
                                                Background="{Binding TextColor, Converter={StaticResource HexToBrush}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="文字边框" Width="120" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding TextBorderEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Width="28" Height="20" Click="TextBorderColor_Click"
                                                Background="{Binding TextBorderColor, Converter={StaticResource HexToBrush}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== 其它 ===== -->
                                <StackPanel x:Name="SecOther">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SectionIndex}" Value="5">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="其它" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="配置" Width="120" VerticalAlignment="Center" />
                                        <Button Content="恢复默认配置" Padding="12,6" Click="ResetDefaults_Click"
                                                ToolTip="重置本条进度条的外观 / 位置 / 指针 / 时间段 / 文字样式（保留名称）" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
