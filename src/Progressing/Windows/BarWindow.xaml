<Window x:Class="Progressing.Windows.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Progressing.Controls"
        xmlns:win="clr-namespace:Progressing.Windows"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="True"
        Width="600" Height="60">
    <Grid x:Name="Root" Background="Transparent">
        <Canvas>
            <!-- 进度条轨道 + 彩色段 + 时间标注 -->
            <controls:BarControl x:Name="BarHost" />

            <!-- 指针图标（位置由 Canvas 基准 + TranslateTransform 平滑补间） -->
            <Image x:Name="PointerImage"
                   Width="16" Height="16"
                   RenderTransformOrigin="0.5,0.5"
                   Stretch="Uniform"
                   Visibility="Hidden">
                <Image.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PointerRotate" />
                        <TranslateTransform x:Name="PointerTranslate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- 备注文字容器（所有备注共用同一显示位置） -->
            <Border x:Name="NoteContainer"
                    Visibility="Collapsed"
                    Background="#00000000"
                    Padding="4,2"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="NoteText"
                               FontSize="26"
                               TextAlignment="Center" />
                    <win:EditModeOverlay x:Name="TextDragHandle"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
