<UserControl x:Class="Progressing.Windows.EditModeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="拖动调整文字位置">
    <Border Width="18" Height="18"
            Background="#591677FF"
            BorderBrush="#991677FF" BorderThickness="1"
            CornerRadius="4"
            Cursor="SizeAll">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="2.5" Height="2.5" Fill="White" Margin="1" />
            <Ellipse Width="2.5" Height="2.5" Fill="White" Margin="1" />
            <Ellipse Width="2.5" Height="2.5" Fill="White" Margin="1" />
        </StackPanel>
    </Border>
</UserControl>
