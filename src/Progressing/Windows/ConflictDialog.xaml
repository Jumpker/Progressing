<Window x:Class="Progressing.Windows.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时间段冲突" Width="420" Height="300"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Border x:Name="RootBorder" Margin="12"
            Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏（拖拽区） -->
            <Grid x:Name="DragStrip" Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="DragStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="时间段冲突" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Padding="0,0"
                        Margin="0,0,10,0" VerticalAlignment="Center" Click="Cancel_Click" ToolTip="关闭" />
            </Grid>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="与已有时间段重合！是否删除下列冲突备注？"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

                <ListBox x:Name="ConflictList" Grid.Row="1" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Range}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text, StringFormat='  {0}'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" Width="80" Height="28" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="确认删除" Width="90" Height="28" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
