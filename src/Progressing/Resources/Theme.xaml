<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 全局配色（与 Core/Palettes.cs 对齐） -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F7F6F3" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderLineBrush" Color="#D8D5CC" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="TextHintBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4A90D9" />

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#F1EFEA" />
        <Setter Property="Foreground" Value="#333" />
        <Setter Property="BorderBrush" Value="#D8D5CC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E6E3DC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D8D5CC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="#C9C4B8" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
